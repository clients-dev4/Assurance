  // cta_click — délégation globale sur tous les liens vers le devis.
  // Sans ça on ne sait pas QUEL point de conversion porte : on mesurait le lead,
  // jamais le chemin. `data-cta` nomme la position (hero / sidebar / inline / bottom / header).
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('a[href*="/devis-assurance-copropriete"]');
    if (!a) return;
    try {
      posthog.capture('cta_click', {
        cta_position: a.getAttribute('data-cta') || 'non-tague',
        cta_label: (a.textContent || '').trim().slice(0, 60),
        page: location.pathname,
      });
    } catch (_) {
      /* le tracking ne bloque jamais la navigation */
    }
  }, { capture: true, passive: true });
