xt-primary-foreground hover:bg-primary/90"> Devis gratuit </a> </div> </div> </div> </header> <script>
  (function () {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    const iconMenu = btn.querySelector('.icon-menu');
    const iconClose = btn.querySelector('.icon-close');
    btn.addEventListener('click', () => {
      const open = !menu.classList.contains('hidden');
      if (open) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconMenu && iconMenu.classList.remove('hidden');
        iconClose && iconClose.classList.add('hidden');
      } else {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        iconMenu && iconMenu.classList.add('hidden');
        iconClose && iconClose.classList.remove('hidden');
      }
    });
  })();
</script> <main class="container-page py-20 md:py-28"> <div class="max-w-2xl mx-auto text-center"> <p class="eyebrow mb-6">Erreur 404</p> <h1 class="font-serif text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-6 text-balance">
