        });
        if (!sessionStorage.getItem(P + 'entry_url')) sessionStorage.setItem(P + 'entry_url', location.href);
        if (!sessionStorage.getItem(P + 'referrer')) { var r = document.referrer; if (r && new URL(r).hostname !== location.hostname) sessionStorage.setItem(P + 'referrer', r); }
      } catch (e) {}
    })();
