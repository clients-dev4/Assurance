    (function () {
      try {
        var P = "copro_";
        var q = new URLSearchParams(location.search);
        ['gclid','msclkid','fbclid','gad_source','gad_campaignid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(function (k) {
